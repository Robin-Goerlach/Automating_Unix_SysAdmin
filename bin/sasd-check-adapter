#!/usr/bin/env perl
# Bridge one inventory check to a controlled, shell-free observation.
use strict;
use FindBin;
use lib "$FindBin::Bin/../lib";
use SASD::Monitor qw(database_projection database_result);

sub unknown {
    print "UNKNOWN - source=UNKNOWN $_[0]\n";
    exit 3;
}

# The original three-argument interface denotes a fixture. Explicit offline
# captures use a separate mode; neither mode establishes live provenance.
my $source = 'FIXTURE';
if (@ARGV == 4 && $ARGV[0] eq '--offline') {
    shift @ARGV;
    $source = 'OFFLINE';
}
@ARGV == 3 or unknown('expected check, host and input');
my ($check,$host,$input) = @ARGV;
$check =~ /\A[A-Za-z][A-Za-z0-9_-]{0,31}\z/ &&
    $host =~ /\A[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,61}[A-Za-z0-9])?\z/
    or unknown('invalid check target');
if ($check =~ /\Adb_/) {
    $source eq 'FIXTURE' or unknown('invalid database projection mode');
    my ($checks,$state,$freshness);
    my $ok = eval {
        ($checks,$state,$freshness) = database_projection($input);
        1;
    };
    $ok or unknown('cannot read offline database state');
    exists($checks->{$check}) && $checks->{$check}->{host} eq $host
        or unknown('database check is not assigned to this host');
    my ($color,$message) = database_result($state->{"$host\t$check"},$freshness,time());
    my %code = (green=>0, yellow=>1, red=>2, purple=>3);
    my @label = qw(OK WARNING CRITICAL UNKNOWN);
    print "$label[$code{$color}] - $message\n";
    exit $code{$color};
}
$check eq 'disk' or unknown("check '$check' is not implemented by SASD");
$input ne '-' or unknown('no disk observation configured');
-f $input && !-l $input && -r $input or unknown('disk input is not a readable regular file');

my $program = "$FindBin::Bin/sasd-disk-watch";
my $pid = open(my $fh, '-|');
defined $pid or unknown('cannot start disk check');
if (!$pid) {
    exec {$program} $program, '--host', $host, '--input', $input or exit 3;
}
my %rank = (green=>0, yellow=>1, red=>2, purple=>3);
my ($best,$message,$invalid);
while (<$fh>) {
    chomp;
    my @fields = split /\t/, $_, -1;
    if (@fields != 4 || $fields[0] ne $host || $fields[1] ne $check ||
        !exists $rank{$fields[2]} || $fields[3] !~ /\A[^\x00-\x1f\x7f]+\z/) {
        $invalid = 1;
        next;
    }
    my (undef,undef,$color,$detail) = @fields;
    if (!defined($best) || $rank{$color} > $rank{$best}) {
        ($best,$message) = ($color,$detail);
    }
}
close $fh or unknown('disk check failed');
$invalid and unknown('invalid disk check result');
defined $best or unknown('disk check returned no observation');
print uc($best), " - source=$source $message\n";
exit $rank{$best};
