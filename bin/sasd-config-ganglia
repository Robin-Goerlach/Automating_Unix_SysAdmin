#!/usr/bin/env perl
# Build isolated Ganglia topology review files from the shared inventory.
use strict;
use File::Spec;
use FindBin;
use lib "$FindBin::Bin/../lib";
use SASD::Monitor qw(read_roles read_host_records read_host_state ganglia_clusters
    atomic_write ensure_dir paths_conflict);

my %options;
my $force = 0;
while (@ARGV) {
    my $arg = shift @ARGV;
    if ($arg eq '--help') {
        print "usage: sasd-config-ganglia --hosts FILE --roles FILE [--state FILE] --gmond-out FILE --gmetad-out FILE [--force]\n";
        exit 0;
    }
    if ($arg eq '--force') {
        $force = 1;
        next;
    }
    $arg =~ /\A--(hosts|roles|state|gmond-out|gmetad-out)\z/ or die "unknown option\n";
    my $key = $1;
    @ARGV && length($ARGV[0]) && !exists($options{$key}) or die "invalid option: $arg\n";
    $options{$key} = shift @ARGV;
}
for my $required (qw(hosts roles gmond-out gmetad-out)) {
    exists $options{$required} or die "--$required is required\n";
}
my ($hosts,$roles) = @options{qw(hosts roles)};
my $explicit_state = exists $options{state};
my $state = $explicit_state ? $options{state} : "$hosts.state";
my $rr = read_roles($roles);
my ($hr) = read_host_records($hosts, $rr, 0);
my $sr = read_host_state($state, $hr, !$explicit_state);
my $clusters = ganglia_clusters($hr, $sr);
my @clusters = sort keys %$clusters;
@clusters && @clusters <= 64 or die "Ganglia requires between 1 and 64 active clusters\n";

my $header = "# SASD Ganglia 3.1.1 topology candidate. Offline and unverified.\n";
my $gmond_out = $options{'gmond-out'};
my $base = $gmond_out;
$base =~ s/\.conf\z//;
my @outputs;
my $aggregate = $header . "# Aggregation endpoints are unresolved.\n";
my $host_count = 0;
for my $cluster (@clusters) {
    my @members = sort keys %{$clusters->{$cluster}};
    $host_count += @members;
    my $gmond = $header
        . "# Members: " . join(',', @members) . "\n"
        . "# Transport unresolved. Supply a reviewed multicast or unicast configuration.\n"
        . "cluster {\n  name = \"$cluster\"\n  owner = \"SASD\"\n}\n";
    my $output = @clusters == 1 ? $gmond_out : "$base.$cluster.conf";
    push @outputs, [$output, $gmond];
    $aggregate .= "# data_source \"$cluster\" unresolved\n";
}
push @outputs, [$options{'gmetad-out'}, $aggregate];

my @paths = ($hosts, $roles, $state);
for my $entry (@outputs) {
    my ($out) = @$entry;
    my $abs = File::Spec->rel2abs($out);
    $abs !~ m!/(?:\.\.?)(?:/|\z)! && $abs !~ /[\x00-\x1f\x7f]/ &&
        $out !~ m!/\z! or die "unsafe Ganglia output path\n";
    my $prefix = '';
    for my $part (grep { length } File::Spec->splitdir($abs)) {
        $prefix .= "/$part";
        -l $prefix and die "symlink in Ganglia output path\n";
    }
    if (-e $out) {
        -f $out && $force or die "Ganglia output exists; use --force on regular files\n";
    }
    for my $previous (@paths) {
        paths_conflict($out, $previous) and die "Ganglia output overlaps another path\n";
    }
    push @paths, $out;
}
for my $entry (@outputs) {
    my ($out,$content) = @$entry;
    my (undef,$dir) = File::Spec->splitpath($out);
    ensure_dir($dir, 0750) if length $dir;
    atomic_write($out, $content, 0640);
}
print "clusters=", scalar(@clusters), " hosts=$host_count endpoints=UNRESOLVED status=APPLIED\n";
