#!/usr/bin/env perl
# Generate a bounded, review-only Nagios 1.0-era object candidate.
# Nagios is a later profile; this file is not a native parser acceptance claim.
use strict;
use File::Spec;
use FindBin;
use lib "$FindBin::Bin/../lib";
use SASD::Monitor qw(read_roles read_host_records read_host_state read_checks read_services
    atomic_write ensure_dir paths_conflict disk_fixture_path classic_database_services);

my ($hosts,$roles,$checks,$services,$state,$out,$profile)=('','','','','','','nagios-1.0a7');
my ($disk_fixture,$fixture_host,$db_config);
my $force=0;
my $state_explicit=0;
while (@ARGV) {
    my $a=shift @ARGV;
    if ($a eq '--hosts') {$hosts=shift @ARGV}
    elsif ($a eq '--roles') {$roles=shift @ARGV}
    elsif ($a eq '--checks') {$checks=shift @ARGV}
    elsif ($a eq '--services') {$services=shift @ARGV}
    elsif ($a eq '--state') {$state=shift @ARGV; $state_explicit=1}
    elsif ($a eq '--out') {$out=shift @ARGV}
    elsif ($a eq '--profile') {$profile=shift @ARGV}
    elsif ($a eq '--disk-fixture') { $disk_fixture=@ARGV ? shift @ARGV : die "missing fixture path\n" }
    elsif ($a eq '--fixture-host') { $fixture_host=@ARGV ? shift @ARGV : die "missing fixture host\n" }
    elsif ($a eq '--database-config') {
        $db_config=shift @ARGV;
        defined $db_config or die "missing database configuration path\n";
    }
    elsif ($a eq '--force') {$force=1}
    elsif ($a eq '--help') { print "usage: sasd-config-nagios --hosts FILE --roles FILE --checks FILE --services FILE [--state FILE] [--disk-fixture FILE --fixture-host HOST] [--database-config FILE] [--profile nagios-1.0a7] [--out FILE --force]\n"; exit 0 }
    else { die "unknown argument: $a\n" }
}
$hosts && $roles && $checks && $services or die "hosts, roles, checks and services are required\n";
$profile eq 'nagios-1.0a7' or die "unsupported Nagios profile: $profile\n";
for my $path ($hosts,$roles,$checks,$services) { -f $path && !-l $path or die "invalid Nagios input file\n" }
$state="$hosts.state" unless $state_explicit;
my $rr=read_roles($roles);
my ($hr)=read_host_records($hosts,$rr,0);
my $sr=read_host_state($state,$hr,!$state_explicit);
my %disabled=map {$_=>1} grep {$sr->{$_}->{state} ne 'enabled'} keys %$sr;
my $fixture_path=disk_fixture_path($disk_fixture,$fixture_host,$hr,\%disabled);
my ($database_services,$database_inputs) = classic_database_services($db_config,$hr,\%disabled);
my $cr=read_checks($checks);
my $sv=read_services($services,$rr,$cr);
my (%groups,%service_groups,%services_by_host);
for my $h (sort keys %$hr) {
    next if $disabled{$h};
    for my $g (split /,/, $hr->{$h}->{groups}) { push @{$groups{$g}},$h if length $g }
    for my $name (sort keys %$sv) {
        my $s=$sv->{$name};
        next unless $s->{role} eq '*' || $s->{role} eq 'baseline' || $s->{role} eq $hr->{$h}->{role};
        push @{$services_by_host{$h}},$s;
        push @{$service_groups{$s->{service}}},"$h,$s->{service}";
    }
}
for my $host (sort keys %$database_services) {
    my %names = map { lc($_->{service}) => 1 } @{$services_by_host{$host} || []};
    for my $service (@{$database_services->{$host}}) {
        my $check = $service->{check};
        exists $names{lc $check} and die "database service overlaps an inventory service\n";
        push @{$services_by_host{$host}}, $service;
        push @{$service_groups{$check}}, "$host,$check";
    }
}
my $text="# SASD Nagios candidate; profile=$profile; target release artifact dated 2002-03-13.\n"
    ."# Offline only.  Review with the selected Nagios binary; no daemon or network action is started.\n"
    ."# SASD status input is synthetic and is not status.dat.\n\n";
$text.="define timeperiod{\n\ttimeperiod_name\t24x7\n\talias\tAll day\n\tsunday\t00:00-24:00\n\tmonday\t00:00-24:00\n\ttuesday\t00:00-24:00\n\twednesday\t00:00-24:00\n\tthursday\t00:00-24:00\n\tfriday\t00:00-24:00\n\tsaturday\t00:00-24:00\n}\n\n";
$text.="define command{\n\tcommand_name\tsasd-check\n\tcommand_line\t\$USER1\$/sasd-check-plugin --plugin \$USER1\$/sasd-check-adapter --check sasd --arg \$ARG1\$ --arg \$HOSTNAME\$ --arg \$ARG2\$\n}\n\n";
$text.="define contact{\n\tcontact_name\tsasd-operator\n\talias\tSASD operator\n\temail\toperator\@localhost\n\thost_notification_period\t24x7\n\tservice_notification_period\t24x7\n}\n\ndefine contactgroup{\n\tcontactgroup_name\tsasd-operators\n\talias\tSASD operators\n\tmembers\tsasd-operator\n}\n\n";
$text.="define hostextinfo{\n\thost_name\t_sasd_template\n\tregister\t0\n}\n\n";
for my $g (sort keys %groups) { $text.="define hostgroup{\n\thostgroup_name\trole_$g\n\talias\tSASD group $g\n\tmembers\t".join(',',sort @{$groups{$g}})."\n}\n\n" }
for my $name (sort keys %service_groups) { $text.="define servicegroup{\n\tservicegroup_name\tservice_$name\n\talias\tSASD $name services\n\tmembers\t".join(',',sort @{$service_groups{$name}})."\n}\n\n" }
for my $h (sort keys %$hr) {
    next if $disabled{$h};
    my $r=$hr->{$h};
    $text.="define host{\n\thost_name\t$h\n\talias\t$h\n\taddress\t$r->{address}\n\thostgroups\t".join(',',map {"role_$_"} grep {length} split /,/, $r->{groups})."\n\tcheck_command\tsasd-check!conn!-\n\tcheck_period\t24x7\n\tmax_check_attempts\t3\n\tactive_checks_enabled\t1\n\tpassive_checks_enabled\t1\n\tnotification_interval\t60\n\tnotification_period\t24x7\n\tnotification_options\td,u,r\n\tcontact_groups\tsasd-operators\n}\n\n";
    for my $s (@{$services_by_host{$h} || []}) {
        my $fixture = $s->{input} ||
            ($fixture_path && $h eq $fixture_host && $s->{check} eq 'disk' ? $fixture_path : '-');
        $text.="define service{\n\thost_name\t$h\n\tservice_description\t$s->{service}\n\tservicegroups\tservice_$s->{service}\n\tcheck_command\tsasd-check!$s->{check}!$fixture\n\tcheck_period\t24x7\n\tmax_check_attempts\t3\n\tcheck_interval\t5\n\tretry_interval\t1\n\tactive_checks_enabled\t1\n\tpassive_checks_enabled\t1\n\tnotification_interval\t60\n\tnotification_period\t24x7\n\tnotification_options\tw,u,c,r\n\tcontact_groups\tsasd-operators\n}\n\n";
    }
}
if ($out eq '') { print $text; exit 0 }
-e $out && !$force and die "output exists; use --force explicitly\n";
for my $input ($hosts,$roles,$checks,$services,$state,grep {length} ($fixture_path,@$database_inputs)) { paths_conflict($out,$input) and die "output path overlaps an input file\n" }
my (undef,$dir)=File::Spec->splitpath($out); ensure_dir($dir,0750) if length $dir;
atomic_write($out,$text,0640); print "output=$out profile=$profile status=APPLIED\n";
