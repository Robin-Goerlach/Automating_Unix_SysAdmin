#!/usr/bin/env perl
# Generate an original, review-only NetSaint configuration candidate.
# The emitted object syntax is not a native parser acceptance claim.
use strict;
use File::Spec;
use FindBin;
use lib "$FindBin::Bin/../lib";
use SASD::Monitor qw(read_roles read_host_records read_host_state read_checks read_services
    atomic_write ensure_dir paths_conflict);
my ($hosts,$roles,$checks,$services,$state,$out,$profile)=('','','','','','','1999'); my $force=0; my $state_explicit=0;
while (@ARGV) { my $a=shift @ARGV;
    if ($a eq '--hosts') {$hosts=shift @ARGV} elsif ($a eq '--roles') {$roles=shift @ARGV} elsif ($a eq '--checks') {$checks=shift @ARGV} elsif ($a eq '--services') {$services=shift @ARGV} elsif ($a eq '--state') {$state=shift @ARGV; $state_explicit=1} elsif ($a eq '--out') {$out=shift @ARGV} elsif ($a eq '--profile') {$profile=shift @ARGV} elsif ($a eq '--force') {$force=1}
    elsif ($a eq '--help') { print "usage: sasd-config-netsaint --hosts FILE --roles FILE --checks FILE --services FILE [--state FILE] [--out FILE --force]\n"; exit 0 } else { die "unknown argument: $a\n" }
}
$hosts && $roles && $checks && $services or die "hosts, roles, checks and services are required\n"; $profile eq '1999' or die "NetSaint profile is 1999\n";
for ($hosts,$roles,$checks,$services) { -f $_ && !-l $_ or die "invalid NetSaint input file\n" } $state="$hosts.state" if $state eq '';
my $rr=read_roles($roles); my ($hr)=read_host_records($hosts,$rr,0); my $sr=read_host_state($state,$hr,!$state_explicit); my %disabled=map {$_=>1} grep {$sr->{$_}->{state} ne 'enabled'} keys %$sr;
my $cr=read_checks($checks); my $sv=read_services($services,$rr,$cr); my (%groups,%services_by_host);
for my $h (sort keys %$hr) { next if $disabled{$h}; for my $g (split /,/, $hr->{$h}->{groups}) { push @{$groups{$g}},$h } for my $n (sort keys %$sv) { my $s=$sv->{$n}; next unless $s->{role} eq '*' || $s->{role} eq 'baseline' || $s->{role} eq $hr->{$h}->{role}; push @{$services_by_host{$h}},[$s->{service},$s->{check}] } }
my $text="# SASD NetSaint candidate; profile=1999; target=NetSaint 0.0.7-era syntax.\n# Offline only; review with the selected binary. No daemon or network action is started.\n\n";
$text.="define timeperiod{\n\ttimeperiod_name\t24x7\n\talias\tAll day\n\t sunday\t00:00-24:00\n\t monday\t00:00-24:00\n\t tuesday\t00:00-24:00\n\t wednesday\t00:00-24:00\n\t thursday\t00:00-24:00\n\t friday\t00:00-24:00\n\t saturday\t00:00-24:00\n}\n\ndefine command{\n\tcommand_name\tcheck-sasd\n\tcommand_line\t\$USER1\$/sasd-check-plugin --check \$ARG1\$\n}\n\ndefine contact{\n\tcontact_name\tsasd-operator\n\talias\tSASD operator\n\temail\toperator\@localhost\n}\n\ndefine contactgroup{\n\tcontactgroup_name\tsasd-operators\n\talias\tSASD operators\n\tmembers\tsasd-operator\n}\n\n";
for my $g (sort keys %groups) { $text.="define hostgroup{\n\thostgroup_name\trole_$g\n\talias\tSASD group $g\n\tmembers\t".join(',',sort @{$groups{$g}})."\n}\n\n" }
$text =~ s{sasd-check-plugin --check}{sasd-check-plugin --plugin \$USER1\$/sasd-check-adapter --check};
for my $h (sort keys %$hr) { next if $disabled{$h}; my $r=$hr->{$h}; $text.="define host{\n\thost_name\t$h\n\talias\t$h\n\taddress\t$r->{address}\n\tcheck_command\tcheck-sasd!conn\n\tcheck_period\t24x7\n\tmax_check_attempts\t3\n\tnotification_interval\t60\n\tnotification_period\t24x7\n\tnotification_options\td,u,r\n\tcontact_groups\tsasd-operators\n}\n\n"; for my $s (@{$services_by_host{$h} || []}) { $text.="define service{\n\thost_name\t$h\n\tservice_description\t$s->[0]\n\tcheck_command\tcheck-sasd!$s->[1]\n\tcheck_period\t24x7\n\tmax_check_attempts\t3\n\tnormal_check_interval\t5\n\tretry_check_interval\t1\n\tnotification_interval\t60\n\tnotification_period\t24x7\n\tnotification_options\tw,u,c,r\n\tcontact_groups\tsasd-operators\n}\n\n" } }
if ($out eq '') { print $text; exit 0 } -e $out && !$force and die "output exists; use --force explicitly\n"; for ($hosts,$roles,$checks,$services,$state) { paths_conflict($out,$_) and die "output path overlaps an input file\n" } my (undef,$dir)=File::Spec->splitpath($out); ensure_dir($dir,0750) if length $dir; atomic_write($out,$text,0640); print "output=$out profile=$profile status=APPLIED\n";
