#!/usr/bin/env perl
# Map one synthetic db-health snapshot to the common local status contract.
use strict;
use FindBin;
use lib "$FindBin::Bin/../lib";
use SASD::Monitor qw(read_inventory read_host_state read_db_instances valid_host
    valid_identifier valid_epoch validate_status);

sub unknown {
    print STDERR "$_[0]\n";
    exit 3;
}

my %options;
while (@ARGV) {
    my $arg = shift @ARGV;
    if ($arg eq '--help') {
        print "usage: sasd-db-health-adapter --input FILE --hosts FILE --roles FILE --instances FILE [--state FILE] [--now EPOCH] [--freshness SECONDS] [--warn-active N --crit-active N] [--format status|mrtg|rrd --instance ID]\n";
        exit 0;
    }
    $arg =~ /\A--(input|hosts|roles|instances|state|now|freshness|warn-active|crit-active|format|instance)\z/
        or unknown('unknown database adapter option');
    my $key = $1;
    @ARGV && length($ARGV[0]) && !exists($options{$key})
        or unknown("invalid database adapter option: $arg");
    $options{$key} = shift @ARGV;
}
for my $required (qw(input hosts roles instances)) {
    exists $options{$required} or unknown("--$required is required");
}
my $output = exists($options{format}) ? $options{format} : 'status';
$output =~ /\A(?:status|mrtg|rrd)\z/ or unknown('invalid output format');
my $target = $options{instance};
($output eq 'status' && !defined($target)) ||
    ($output ne 'status' && valid_identifier($target))
    or unknown('metric output requires an explicit instance');
my $now = exists($options{now}) ? $options{now} : time();
my $freshness = exists($options{freshness}) ? $options{freshness} : 900;
valid_epoch($now) && $freshness =~ /\A[1-9][0-9]{0,8}\z/ or unknown('invalid database time boundaries');
my $warn = $options{'warn-active'};
my $crit = $options{'crit-active'};
if (defined($warn) || defined($crit)) {
    defined($warn) && defined($crit) && $warn =~ /\A[0-9]{1,9}\z/ &&
        $crit =~ /\A[0-9]{1,9}\z/ && $warn < $crit or unknown('invalid active session thresholds');
}

my $instances;
my $inventory_ok = eval {
    my ($hosts) = read_inventory($options{hosts}, $options{roles});
    my $explicit_state = exists $options{state};
    my $state = read_host_state($explicit_state ? $options{state} : "$options{hosts}.state",
        $hosts, !$explicit_state);
    $instances = read_db_instances($options{instances}, $hosts, $state);
    1;
};
if (!$inventory_ok) {
    print STDERR $@;
    exit 3;
}

my $input = $options{input};
-f $input && !-l $input or unknown('observation input must be a regular file');
open(my $fh, '<', $input) or unknown('cannot read database observation');
binmode $fh;
my $data = '';
while (length($data) <= 4096) {
    my $read = read($fh, $data, 4097 - length($data), length($data));
    defined $read or unknown('cannot read database observation');
    last if !$read;
}
close $fh or unknown('cannot close database observation');
length($data) <= 4096 or unknown('database observation exceeds byte limit');

my @fields = split /\n/, $data;
my $format = shift @fields;
defined($format) && $format =~ /\ASASD-DB-HEALTH-1\r?\z/
    or unknown('unsupported database observation format');
my @required = qw(product version instance host source diagnostic observed_at scope connections active uptime visibility);
my %allowed = map { $_ => 1 } (@required, 'result');
my %observation;
for my $line (@fields) {
    $line =~ s/\r\z//;
    next if $line eq '';
    $line =~ /\A([a-z][a-z0-9_]{0,23})=([\x20-\x7e]{1,240})\z/
        or unknown('invalid database observation field');
    my ($key,$value) = ($1,$2);
    exists $allowed{$key} or unknown('unknown database observation field');
    !exists $observation{$key} or unknown("duplicate database observation field: $key");
    $observation{$key} = $value;
}
for my $key (@required) {
    exists $observation{$key} or unknown("missing database observation field: $key");
}
my ($id,$host,$product,$version,$epoch,$scope,$visible) =
    @observation{qw(instance host product version observed_at scope visibility)};
valid_identifier($id) && valid_host($host) && valid_epoch($epoch) &&
    $product =~ /\A(?:mariadb|mysql|postgresql)\z/ &&
    $version =~ /\A[0-9]{1,5}(?:\.[0-9]{1,5}){0,2}\z/ &&
    $visible =~ /\A(?:complete|partial|unavailable)\z/
    or unknown('invalid database observation identity or metadata');
$observation{source} eq 'OFFLINE' && $observation{diagnostic} eq 'db-health'
    or unknown('observation source is not an accepted db-health fixture');
my $expected_scope = $product eq 'postgresql' ? 'cluster' : 'server';
$scope eq $expected_scope or unknown('invalid database observation scope');
my $result = exists($observation{result}) ? $observation{result} : 'ok';
$result =~ /\A(?:ok|failed)\z/ or unknown('invalid database diagnostic result');
for my $key (qw(connections active uptime)) {
    $observation{$key} =~ /\A(?:[0-9]{1,15}|unknown)\z/ or unknown('invalid database metric');
}

!defined($target) || $id eq $target or unknown('observation does not match metric target');
my $record = $instances->{$id};
defined $record or unknown('unknown database instance');
$record->{host} eq $host or unknown('database instance host mismatch');
$record->{enabled} or unknown('database host or instance is not enabled');
$epoch <= $now or unknown('database observation is from the future');

my %tested_families = (
    mariadb    => qr/\A10\.11(?:\.[0-9]{1,5})?\z/,
    mysql      => qr/\A8\.0(?:\.[0-9]{1,5})?\z/,
    postgresql => qr/\A15(?:\.[0-9]{1,5})?\z/,
);
my $expected = $record->{version};
my ($connections,$active,$uptime) = @observation{qw(connections active uptime)};
my $reason = '';
if ($record->{product} ne $product || $version !~ /\A\Q$expected\E(?:\.|\z)/) {
    $reason = 'product or version does not match inventory';
} elsif ($version !~ $tested_families{$product}) {
    $reason = 'product version is outside the synthetic support matrix';
} elsif ($now - $epoch > $freshness) {
    $reason = 'observation is stale';
} elsif ($result eq 'failed') {
    $reason = 'diagnostic failed';
} elsif ($visible ne 'complete') {
    $reason = 'health visibility is incomplete';
} elsif (grep { $_ eq 'unknown' } ($connections,$active,$uptime)) {
    $reason = 'health metric unavailable';
} elsif ($product eq 'postgresql' && $active > $connections) {
    $reason = 'active client backends exceed total client backends';
}
my $check = $record->{check};
if ($output eq 'rrd') {
    # Emit an explicit UNKNOWN sample for an eligible unavailable snapshot.
    my @metrics = $reason eq '' ? ($connections,$active,$uptime) : ('U','U','U');
    print join("\t", $host,$check,join(':', $epoch,@metrics)), "\n";
    exit($reason eq '' ? 0 : 3);
}
if ($output eq 'mrtg') {
    $reason eq '' or unknown($reason);
    print join("\n", $connections,$active,$uptime,"$host/$id"), "\n";
    exit 0;
}

my $color = 'purple';
if ($reason eq '') {
    if (!defined $warn) {
        $reason = 'no active-session policy configured';
    } elsif ($active >= $crit) {
        ($color,$reason) = ('red', 'active sessions at or above critical threshold');
    } elsif ($active >= $warn) {
        ($color,$reason) = ('yellow', 'active sessions at or above warning threshold');
    } else {
        ($color,$reason) = ('green', 'active sessions below warning threshold');
    }
}
my $message = "source=OFFLINE diagnostic=db-health instance=$id reason=$reason";
if ($color ne 'purple') {
    $message .= " product=$product version=$version connections=$connections active=$active uptime=$uptime";
}
validate_status($host, $check, $color, $message);
print join("\t", $host, $check, $color, $message, $epoch), "\n";
my %exit = (green=>0, yellow=>1, red=>2, purple=>3);
exit $exit{$color};
