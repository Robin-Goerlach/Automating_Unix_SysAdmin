#!/bin/sh
set -eu
usage(){ echo "usage: sasd-golden-restore --repository DIR --image-id ID --dest DIR [--dry-run|--apply]" >&2; exit 2; }
repository= image= dest= mode=
die(){ echo "sasd-golden-restore: $*" >&2; exit 2; }
while [ "$#" -gt 0 ]; do
    case "$1" in
        --repository) [ "$#" -ge 2 ] || usage; repository=$2; shift 2 ;;
        --image-id) [ "$#" -ge 2 ] || usage; image=$2; shift 2 ;;
        --dest) [ "$#" -ge 2 ] || usage; dest=$2; shift 2 ;;
        --dry-run) mode=dry-run; shift ;;
        --apply) mode=apply; shift ;;
        --help) usage ;;
        *) die "unknown argument: $1" ;;
    esac
done
[ -n "$repository" ] && [ -n "$image" ] && [ -n "$dest" ] || usage
[ "$mode" = dry-run ] || [ "$mode" = apply ] || die "select --dry-run or --apply"
case "$repository" in /*) ;; *) die "repository must be absolute" ;; esac
case "$dest" in /*) ;; *) die "destination must be absolute" ;; esac
case "$repository" in */../*|*/..|*/./*|*/.) die "unsafe repository path" ;; esac
case "$dest" in */../*|*/..|*/./*|*/.) die "unsafe destination path" ;; esac
case "$image" in ''|*[!A-Za-z0-9._-]*) die "unsafe image id" ;; esac
[ -d "$repository" ] && [ ! -L "$repository" ] || die "invalid repository"
manifest="$repository/manifests/$image.tsv"; checksum="$repository/checksums/$image.sha256"
[ -f "$manifest" ] && [ ! -L "$manifest" ] || die "missing manifest"
[ -f "$checksum" ] && [ ! -L "$checksum" ] || die "missing checksum"
archive=$(awk -F '\t' '$1 == "archive_file" { print $2 }' "$manifest")
expected=$(awk -F '\t' '$1 == "sha256" { print $2 }' "$manifest")
[ -n "$archive" ] && [ -n "$expected" ] || die "incomplete manifest"
recorded=$(awk -v path="$(printf '%s' "$archive")" '$2 == path { print $1 }' "$checksum")
[ "$recorded" = "$expected" ] || die "checksum record mismatch"
case "$archive" in /*|*../*|*'/.'*) die "unsafe archive path" ;; esac
archive="$repository/$archive"
[ -f "$archive" ] && [ ! -L "$archive" ] || die "missing archive"
actual=$(sha256sum "$archive" | awk '{print $1}')
[ "$actual" = "$expected" ] || die "archive checksum mismatch"
check_ancestors(){ p=$1; while [ "$p" != "/" ] && [ -n "$p" ]; do [ ! -L "$p" ] || die "symlink path component: $p"; n=$(dirname "$p"); [ "$n" != "$p" ] || break; p=$n; done; }
case "$dest" in "$repository"/*) die "destination must not be inside repository" ;; esac
[ ! -e "$dest" ] || die "destination exists; refusing overwrite"
parent=$(dirname "$dest"); [ -d "$parent" ] || die "destination parent does not exist"; check_ancestors "$parent"
list=$(mktemp); trap 'rm -f "$list"' EXIT HUP INT TERM
tar -tf "$archive" > "$list" || die "cannot read archive"
while IFS= read -r entry; do
    case "$entry" in
        ''|./|./[!/]*) ;;
        /*|*../*|../*|*/..|*/./*) die "unsafe archive path: $entry" ;;
        *[![:print:]]*) die "unsafe archive name: $entry" ;;
    esac
done < "$list"
tar -tvf "$archive" | awk 'substr($0,1,1) ~ /[bchpls]/ || $0 ~ / -> / { bad=1 } END { exit bad ? 1 : 0 }' || die "archive contains unsafe link or special file"
[ "$mode" = dry-run ] && { echo "restore=dry-run image=$image destination=$dest"; exit 0; }
tmp=$(mktemp -d "$parent/.sasd-golden-restore.XXXXXX"); cleanup(){ rm -rf "$tmp"; }; trap cleanup EXIT HUP INT TERM
mkdir "$tmp/root"
tar --no-same-owner --no-same-permissions -xf "$archive" -C "$tmp/root" || die "cannot extract archive"
find "$tmp/root" \( -type l -o -type b -o -type c -o -type p \) -print -quit | grep . >/dev/null 2>&1 && die "unsafe extracted object"
mv "$tmp/root" "$dest"
trap - EXIT HUP INT TERM
echo "restore=OK image=$image destination=$dest"
