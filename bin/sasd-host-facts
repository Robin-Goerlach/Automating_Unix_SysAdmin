#!/bin/sh
# SASD Unix administration: portable, read-only host inventory.
# No /proc, systemd, external agent or root privileges are required.
set -eu
if [ "$#" -ne 0 ]; then
    echo "usage: sasd-host-facts" >&2
    exit 2
fi
LC_ALL=C
export LC_ALL
host=$(uname -n) || exit 3
system=$(uname -s) || exit 3
release=$(uname -r) || exit 3
machine=$(uname -m) || exit 3
printf '%s\t%s\t%s\t%s\n' "$host" "$system" "$release" "$machine"
