#!/bin/sh
set -eu
usage(){ echo "usage: sasd-monitor-backup --root PREFIX --out ARCHIVE [--force]" >&2; exit 2; }
root= out= force=0
die(){ echo "sasd-monitor-backup: $*" >&2; exit 2; }
while [ "$#" -gt 0 ]; do
    case "$1" in
        --root) [ "$#" -ge 2 ] || usage; root=$2; shift 2 ;;
        --out) [ "$#" -ge 2 ] || usage; out=$2; shift 2 ;;
        --force) force=1; shift ;;
        --help) usage ;;
        *) die "unknown argument: $1" ;;
    esac
done
case "$root" in /*) ;; *) die "root must be absolute" ;; esac
[ -d "$root" ] && [ ! -L "$root" ] || die "invalid root"
case "$root" in */../*|*/..|*/./*|*/.) die "unsafe root path" ;; esac
check_ancestors(){ p=$1; while [ "$p" != "/" ] && [ -n "$p" ]; do [ ! -L "$p" ] || die "symlink path component: $p"; n=$(dirname "$p"); [ "$n" != "$p" ] || break; p=$n; done; }
check_ancestors "$root"
[ -n "$out" ] || die "--out is required"
case "$out" in "$root"/*) die "archive must not be inside root" ;; esac
parent=$(dirname "$out"); [ -d "$parent" ] || die "archive parent does not exist"; check_ancestors "$parent"
[ ! -e "$out" ] || [ "$force" -eq 1 ] || die "archive exists; use --force explicitly"
tmp="$out.tmp.$$"
trap 'rm -f "$tmp"' EXIT HUP INT TERM
for p in etc/sasd-monitor.conf etc/hosts.tsv etc/roles.tsv etc/checks.tsv var/status var/history var/metrics var/reports var/operations var/enrollment/requests var/enrollment/records share/mrtg; do
    [ -e "$root/$p" ] || die "missing backup path: $p"
    [ ! -L "$root/$p" ] || die "backup path is a symlink: $p"
done
tar -cf "$tmp" -C "$root" \
    etc/sasd-monitor.conf etc/hosts.tsv etc/roles.tsv etc/checks.tsv \
    var/status var/history var/metrics var/reports var/operations \
    var/enrollment/requests var/enrollment/records share/mrtg
[ ! -e "$root/var/enrollment/events.tsv" ] || tar -rf "$tmp" -C "$root" var/enrollment/events.tsv
mv "$tmp" "$out"
trap - EXIT HUP INT TERM
chmod 0600 "$out"
echo "backup=OK archive=$out"
