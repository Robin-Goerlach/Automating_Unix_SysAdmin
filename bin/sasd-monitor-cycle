#!/usr/bin/env perl
use strict;
use FindBin;
use File::Spec;
use lib "$FindBin::Bin/../lib";
use SASD::Monitor qw(read_config read_inventory read_checks applicable_checks read_latest read_state atomic_write ensure_dir now_seconds);
my($file,$now)=('','');while(@ARGV){my$a=shift@ARGV;if($a eq '--config'){$file=shift@ARGV;}elsif($a eq '--now'){$now=shift@ARGV;}elsif($a eq '--help'){print "usage: sasd-monitor-cycle --config FILE [--now EPOCH]\n";exit 0;}else{die "unknown argument: $a\n";}}
$file&&-f$file&&! -l$file or die "invalid configuration file\n";$now eq '' and $now=time();$now=~ /\A[0-9]{1,15}\z/ or die "invalid now\n";
my$cfg=read_config($file);my($hosts,$roles)=read_inventory($cfg->{inventory_path},$cfg->{roles_path});my$checks=read_checks($cfg->{checks_path});my$old=read_state($cfg->{state_file_path});my$new;my@rows;my@events;my$latest_dir=$cfg->{status_dir_path}.'/latest';-l$latest_dir and die"refusing symlink latest directory\n";
for my$h(sort keys%$hosts){for my$c(applicable_checks($hosts->{$h},$checks)){my$p="$latest_dir/$h.$c";my$obs=read_latest($p);my($observed,$state,$received,$source,$message)=('none','purple','0','-','no report received');if($obs){$observed=$obs->{color};$received=$obs->{received};$source=$obs->{source};$message=$obs->{message};$state=($now-$received>$cfg->{freshness})?'purple':$observed;$message="stale report: $message" if $state eq 'purple'&&$observed ne 'purple';}my$key="$h\t$c";$new->{$key}={cycle=>$now,host=>$h,check=>$c,observed=>$observed,state=>$state,received=>$received,source=>$source,message=>$message};push@rows,join("\t",$now,$h,$c,$observed,$state,$received,$source,$message);if(!exists$old->{$key}||$old->{$key}->{state}ne$state){my$previous=exists$old->{$key}?$old->{$key}->{state}:'none';push@events,join("\t",$now,$h,$c,$previous,$state,$source,$message);}}}
ensure_dir($cfg->{status_dir_path},0750);atomic_write($cfg->{state_file_path},join("\n",@rows)."\n",0640);my$hist=$cfg->{history_file_path};my@history=();if(-f$hist&&! -l$hist){open(H,'<',$hist)or die"cannot read history: $!\n";@history=<H>;close H;chomp@history;}push@history,@events;splice@history,0,@history-$cfg->{history_retention} if @history>$cfg->{history_retention};my$hc=join("\n",@history);$hc.="\n" if length$hc;my($v,$d,$f)=File::Spec->splitpath($hist);ensure_dir($d,0750) if length$d;atomic_write($hist,$hc,0640);print join("\n",map{"$new->{$_}->{host}\t$new->{$_}->{check}\t$new->{$_}->{state}\t$new->{$_}->{message}"}sort keys%$new),"\n";exit 0;
