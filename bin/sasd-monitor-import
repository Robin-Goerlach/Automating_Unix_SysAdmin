#!/usr/bin/env perl
use strict;
use FindBin;
use lib "$FindBin::Bin/../lib";
use SASD::Monitor qw(read_config read_inventory read_monitor_checks check_applies
    validate_status valid_epoch atomic_write ensure_dir read_latest);

my ($file,$input,$source,$received) = ('','-','local','');
while (@ARGV) {
    my $arg = shift @ARGV;
    if ($arg eq '--config') { $file = shift @ARGV }
    elsif ($arg eq '--input') { $input = shift @ARGV }
    elsif ($arg eq '--source') { $source = shift @ARGV }
    elsif ($arg eq '--received-at') { $received = shift @ARGV }
    elsif ($arg eq '--help') {
        print "usage: sasd-monitor-import --config FILE [--input FILE|-] [--source ID] [--received-at EPOCH]\n";
        exit 0;
    } else { die "unknown argument: $arg\n" }
}
$file && -f $file && !-l $file or die "invalid configuration file\n";
defined($source) && $source =~ /\A[A-Za-z0-9_.:-]{1,64}\z/ && $source ne 'ssh'
    or die "invalid or reserved source\n";
$received = time() if defined($received) && $received eq '';
valid_epoch($received) or die "invalid received-at\n";
my $cfg = read_config($file);
my ($hosts) = read_inventory($cfg->{inventory_path}, $cfg->{roles_path});
my $checks = read_monitor_checks($cfg, $hosts);
my $offline_db = $source eq 'offline-db';
!$offline_db || exists($cfg->{offline_databases_path}) or die "offline database source requires lab configuration\n";
defined($input) or die "missing input path\n";

my $fh;
if ($input ne '-') {
    -f $input && !-l $input or die "invalid input\n";
    open($fh, '<', $input) or die "cannot read input: $!\n";
} else {
    $fh = \*STDIN;
}
my (@records,%batch);
while (<$fh>) {
    length($_) <= 4096 or die "status record is too long\n";
    chomp;
    s/\r\z//;
    next if /^\s*$/ || /^\s*#/;
    my @fields = split /\t/, $_, -1;
    @fields == 4 || @fields == 5 or die "status record needs four fields or four fields plus measurement epoch\n";
    my ($host,$check,$color,$message,$epoch) = @fields;
    exists($hosts->{$host}) or die "unknown host: $host\n";
    my $target = $checks->{$check};
    defined $target or die "unknown check: $check\n";
    check_applies($hosts->{$host}, $target) or die "check '$check' is not assigned to host $host\n";
    validate_status($host, $check, $color, $message);
    my $required_source = $target->{source};
    my $offline_marker = $message =~ /\Asource=OFFLINE diagnostic=db-health /;
    if ($offline_db) {
        defined($required_source) && $source eq $required_source
            or die "offline database source is not assigned to this check\n";
        my $instance = substr($check, 3);
        defined($epoch) && $offline_marker && $message =~ /\Asource=OFFLINE diagnostic=db-health instance=\Q$instance\E /
            or die "offline database status requires its source marker and measurement epoch\n";
    } elsif (defined($required_source) || $offline_marker) {
        die "check requires the offline database source\n";
    }
    $epoch = $received unless defined $epoch;
    valid_epoch($epoch) or die "status record needs four fields or valid measurement epoch\n";
    $epoch <= $received + ($offline_db ? 0 : 300) or die "measurement epoch is too far in the future\n";
    my $key = "$host\t$check";
    !exists($batch{$key}) or die "duplicate observation in import\n";
    @records < 1000 or die "too many status observations\n";
    $batch{$key} = 1;
    push @records, [$host,$check,$color,$message,$epoch];
}
close $fh or die "cannot close status input: $!\n" if $input ne '-';
my $dir = $cfg->{status_dir_path};
ensure_dir($dir, 0750);
my $latest = "$dir/latest";
ensure_dir($latest, 0750);
for my $record (@records) {
    my ($host,$check,$color,$message,$epoch) = @$record;
    my $old = read_latest("$latest/$host.$check");
    next unless $old;
    $old->{source} ne 'ssh' or die "unauthenticated observation cannot replace authenticated observation\n";
    !$offline_db || $old->{source} eq $source
        or die "offline database observation cannot replace a different source\n";
    $old->{received} <= $epoch or die "older observation would overwrite newer observation\n";
    if ($old->{received} == $epoch &&
        ($old->{color} ne $color || $old->{message} ne $message || $old->{source} ne $source)) {
        die "conflicting observation at same measurement epoch\n";
    }
}
for my $record (@records) {
    my ($host,$check,$color,$message,$epoch) = @$record;
    atomic_write("$latest/$host.$check",
        join("\t", $epoch,$host,$check,$color,$message,$source) . "\n", 0640);
}
print "imported=", scalar(@records), " received=$received\n";
