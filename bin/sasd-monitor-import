#!/usr/bin/env perl
use strict;
use FindBin;
use lib "$FindBin::Bin/../lib";
use SASD::Monitor qw(read_config read_inventory read_checks validate_status valid_host valid_identifier valid_epoch atomic_write ensure_dir read_latest);
my($file,$input,$source,$received)=('','-','local','');
while(@ARGV){my$a=shift@ARGV;if($a eq '--config'){$file=shift@ARGV;}elsif($a eq '--input'){$input=shift@ARGV;}elsif($a eq '--source'){$source=shift@ARGV;}elsif($a eq '--received-at'){$received=shift@ARGV;}elsif($a eq '--help'){print "usage: sasd-monitor-import --config FILE [--input FILE|-] [--source ID] [--received-at EPOCH]\n";exit 0;}else{die "unknown argument: $a\n";}}
$file && -f $file && !-l $file or die "invalid configuration file\n";
$source =~ /\A[A-Za-z0-9_.:-]{1,64}\z/ or die "invalid source\n";
$received eq '' and $received=time(); valid_epoch($received) or die "invalid received-at\n";
my$cfg=read_config($file);my($hosts,$roles)=read_inventory($cfg->{inventory_path},$cfg->{roles_path});my$checks=read_checks($cfg->{checks_path});
if($input ne '-'){ -f $input&&!-l $input or die "invalid input\n";open(INPUT,'<',$input)or die "cannot read input: $!\n";}else{*INPUT=*STDIN;}
my@records;my%batch;while(<INPUT>){length($_)<=4096 or die "status record is too long\n";chomp;s/\r\z//;next if /^\s*$/||/^\s*#/;my@v=split(/\t/,$_, -1);(@v==4||@v==5) or die "status record needs four fields or four fields plus measurement epoch\n";my($h,$c,$color,$message,$record_received)=@v;if(defined($record_received)){ valid_epoch($record_received) or die "status record needs four fields or valid measurement epoch\n"; }else{ $record_received=$received; }$record_received <= $received + 300 or die "measurement epoch is too far in the future\n";exists$hosts->{$h} or die "unknown host: $h\n";exists$checks->{$c} or die "unknown check: $c\n";my$role=$checks->{$c}->{role};($role eq '*'||$role eq 'baseline'||$role eq $hosts->{$h}->{role})or die "check '$c' is not assigned to host $h\n";validate_status($h,$c,$color,$message);my$key="$h\t$c";exists$batch{$key} and die "duplicate observation in import\n";$batch{$key}=1;push@records,[$h,$c,$color,$message,$record_received];}@records<=1000 or die "too many status observations\n";close INPUT if $input ne '-';
my$dir=$cfg->{status_dir_path};ensure_dir($dir,0750);my$latest="$dir/latest";ensure_dir($latest,0750);for my$r(@records){my($h,$c,$color,$message,$record_received)=@$r;my$path="$latest/$h.$c";my$old=read_latest($path);if($old&&$old->{received}>$record_received){die "older observation would overwrite newer observation\n";}if($old&&$old->{received}==$record_received&&($old->{color}ne$color||$old->{message}ne$message||$old->{source}ne$source)){die "conflicting observation at same measurement epoch\n";}}for my$r(@records){my($h,$c,$color,$message,$record_received)=@$r;atomic_write("$latest/$h.$c",join("\t",$record_received,$h,$c,$color,$message,$source)."\n",0640);}print "imported=",scalar(@records)," received=$received\n";exit 0;
