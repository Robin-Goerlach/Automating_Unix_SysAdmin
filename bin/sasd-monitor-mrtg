#!/usr/bin/env perl
use strict;use FindBin;use File::Spec;use lib "$FindBin::Bin/../lib";use SASD::Monitor qw(read_config read_inventory valid_identifier atomic_write ensure_dir);
my($file,$out,$metric,$force)=('','','interface','');while(@ARGV){my$a=shift@ARGV;if($a eq'--config'){$file=shift@ARGV;}elsif($a eq'--out'){$out=shift@ARGV;}elsif($a eq'--metric'){$metric=shift@ARGV;}elsif($a eq'--force'){$force=1;}elsif($a eq'--help'){print"usage: sasd-monitor-mrtg --config FILE [--metric NAME] [--out FILE [--force]]\n";exit 0;}else{die"unknown argument: $a\n";}}
$file&&-f$file&&! -l$file or die"invalid configuration file\n";valid_identifier($metric)or die"invalid metric\n";my$cfg=read_config($file);my($hosts,$roles)=read_inventory($cfg->{inventory_path},$cfg->{roles_path});my$text="# SASD candidate MRTG configuration; review before enabling MRTG.\n# No SNMP credentials or network polling are embedded.\n";for my$h(sort keys%$hosts){my$id=$h;$id=~s/[^A-Za-z0-9_]/_/g;my$sample=File::Spec->catfile($cfg->{rrd_dir_path},$h.'.'.$metric.'.tsv');$text.="\n# $h ($hosts->{$h}->{role})\nTarget[${id}_${metric}]: `$cfg->{mrtg_command_path} --input $sample`\nSetEnv[${id}_${metric}]: MRTG_TARGET_HOST=$h\nTitle[${id}_${metric}]: SASD $metric for $h\n";}if($out eq''){print$text;}else{-e$out&&!$force and die"output exists; use --force explicitly\n";my($v,$d,$f)=File::Spec->splitpath($out);length$d&&ensure_dir($d,0750);atomic_write($out,$text,0640);}exit 0;
