#!/usr/bin/env perl
# Build a deterministic shared host/service selection for disposable staging.
use strict; use FindBin; use lib "$FindBin::Bin/../lib";
use SASD::Monitor qw(read_roles read_host_records read_checks valid_identifier valid_profile valid_host);
my ($hosts,$roles,$checks,$services,$state_path,$out,$apply,$check) = ('','','','','','','',0,0);
while (@ARGV) { my $a=shift @ARGV; if ($a eq '--hosts') {$hosts=shift @ARGV} elsif ($a eq '--roles') {$roles=shift @ARGV} elsif ($a eq '--checks') {$checks=shift @ARGV} elsif ($a eq '--services') {$services=shift @ARGV} elsif ($a eq '--state') {$state_path=shift @ARGV} elsif ($a eq '--out') {$out=shift @ARGV} elsif ($a eq '--apply') {$apply=1} elsif ($a eq '--check') {$check=1} elsif ($a eq '--help') { print "usage: sasd-site-config --hosts hosts.tsv --roles roles.tsv --checks checks.tsv --services services.tsv [--state state.tsv] [--out DIR --apply|--check]\n"; exit 0; } else { die "unknown argument: $a\n"; } }
$hosts && $roles && $checks && $services or die "all inventory inputs are required\n";
for ($hosts,$roles,$checks,$services) { -f $_ && !-l $_ or die "invalid input file\n"; }
$out or die "--out is required\n" if $apply;
$state_path = "$hosts.state" if $state_path eq '';
sub safe { my ($s)=@_; return defined($s) && $s !~ /[\x00-\x1f\x7f]/; }
sub ident { my ($s)=@_; return defined($s) && $s =~ /\A[A-Za-z][A-Za-z0-9_-]{0,31}\z/; }
sub profile { my ($s)=@_; return defined($s) && $s =~ /\A[A-Za-z0-9][A-Za-z0-9_.-]{0,31}\z/; }
sub host { my ($s)=@_; return defined($s) && $s =~ /\A[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,61}[A-Za-z0-9])?\z/; }
sub fields { my ($l,$n)=@_; my @v=split /\t/,$l,-1; @v==$n or die "invalid record\n"; safe($_) or die "control character\n" for @v; return @v; }
my (%role,%check,%host,%service,%state);
my $role_ref=read_roles($roles); my ($host_ref)=read_host_records($hosts,$role_ref,0); my $check_ref=read_checks($checks);
%role=map { $_ => 1 } keys %$role_ref; %check=map { $_ => $check_ref->{$_}->{role} } keys %$check_ref;
%host=map { $_ => [ $host_ref->{$_}->{host},$host_ref->{$_}->{address},$host_ref->{$_}->{os},$host_ref->{$_}->{role},$host_ref->{$_}->{groups},$host_ref->{$_}->{profile} ] } keys %$host_ref;
open(F,"<$services") or die $!; while (<F>) {chomp;s/\r\z//;next if /^\s*$/||/^\s*#/;my @v=fields($_,5);ident($v[0])&&($v[1] eq '*'||$v[1] eq 'baseline'||ident($v[1]))&&ident($v[2])&&exists($check{$v[2]})&&profile($v[3])&&length($v[4])<=120 or die "invalid service\n";exists($service{$v[0]}) and die "duplicate service\n";$service{$v[0]}=\@v;}close F;
if (-e $state_path) { -l $state_path and die "state file is a symlink\n"; open(F,"<$state_path") or die $!; while (<F>) { chomp; s/\r\z//; next if /^\s*$/ || /^\s*#/; my ($h,$s,$reason)=fields($_,3); host($h) && $s =~ /\A(?:enabled|disabled|removed)\z/ or die "invalid host state\n"; $state{$h}=$s; } close F; }
sub applies { my($s,$r)=@_; return $s->[1] eq '*'||$s->[1] eq 'baseline'||$s->[1] eq $r; }
my @lines; my $active=0; for my $h (sort keys %host) { next if exists($state{$h}) && $state{$h} ne 'enabled'; $active++; for my $n (sort keys %service) { my $s=$service{$n}; next unless applies($s,$host{$h}->[3]); $check{$s->[2]} ne '*' && $check{$s->[2]} ne 'baseline' && $check{$s->[2]} ne $s->[1] and die "service/check role conflict\n"; push @lines,join("\t",$h,@$s)."\n"; } }
print "hosts=",$active," selections=",scalar(@lines)," status=OK\n" if $check;
if ($apply) {
    -e $out and die "output exists; choose a new staging directory\n"; mkdir($out,0700) or die "cannot create staging directory: $!\n"; open(O,">$out/host-services.tsv") or die $!; print O @lines; close O or die $!; open(M,">$out/manifest.tsv") or die $!; print M "host-services.tsv\t",scalar(@lines),"\n"; close M or die $!; print "staging=$out status=APPLIED\n";
}
