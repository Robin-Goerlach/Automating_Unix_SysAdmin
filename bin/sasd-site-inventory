#!/usr/bin/env perl
# Validate and query the shared SASD site inventory.
use strict;
use FindBin;
use lib "$FindBin::Bin/../lib";
use SASD::Monitor qw(read_inventory valid_host valid_identifier);

my ($input, $roles, $want_role, $want_host, $list, $check) = ('','','','','','');
while (@ARGV) {
    my $a = shift @ARGV;
    if ($a eq '--input') { $input = shift @ARGV; }
    elsif ($a eq '--roles') { $roles = shift @ARGV; }
    elsif ($a eq '--role') { $want_role = shift @ARGV; }
    elsif ($a eq '--host') { $want_host = shift @ARGV; }
    elsif ($a eq '--list') { $list = 1; }
    elsif ($a eq '--check') { $check = 1; }
    elsif ($a eq '--help') { print "usage: sasd-site-inventory --input hosts.tsv --roles roles.tsv [--list|--role ROLE|--host HOST|--check]\n"; exit 0; }
    else { die "unknown argument: $a\n"; }
}
$input && $roles && ($list || $check || $want_role || $want_host)
    or die "input, roles and a query are required\n";
my ($hosts, $role_records) = read_inventory($input, $roles);
if ($want_host) {
    valid_host($want_host) && exists $hosts->{$want_host} or die "unknown host: $want_host\n";
    print join("\t", @{$hosts->{$want_host}}{qw(host address os role groups profile)}), "\n";
} elsif ($want_role) {
    valid_identifier($want_role) && exists $role_records->{$want_role} or die "unknown role: $want_role\n";
    for my $name (sort keys %$hosts) {
        print join("\t", @{$hosts->{$name}}{qw(host address os role groups profile)}), "\n"
            if $hosts->{$name}->{role} eq $want_role;
    }
} elsif ($list) {
    for my $name (sort keys %$hosts) {
        print join("\t", @{$hosts->{$name}}{qw(host address os role groups profile)}), "\n";
    }
}
print "hosts=", scalar(keys %$hosts), " roles=", scalar(keys %$role_records), " status=OK\n" if $check;
