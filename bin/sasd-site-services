#!/usr/bin/env perl
# Validate and resolve the independent SASD service model.
# This selects work; it does not start, stop, configure or contact services.
use strict;
use FindBin;
use lib "$FindBin::Bin/../lib";
use SASD::Monitor qw(read_roles read_host_records read_checks read_services valid_host);

my ($hosts_file,$roles_file,$checks_file,$services_file,$want_host,$list,$check) = ('','','','','','','');
while (@ARGV) {
    my $a = shift @ARGV;
    if ($a eq '--hosts') { $hosts_file = shift @ARGV; }
    elsif ($a eq '--roles') { $roles_file = shift @ARGV; }
    elsif ($a eq '--checks') { $checks_file = shift @ARGV; }
    elsif ($a eq '--services') { $services_file = shift @ARGV; }
    elsif ($a eq '--host') { $want_host = shift @ARGV; }
    elsif ($a eq '--list') { $list = 1; }
    elsif ($a eq '--check') { $check = 1; }
    elsif ($a eq '--help') { print "usage: sasd-site-services --hosts hosts.tsv --roles roles.tsv --checks checks.tsv --services services.tsv [--list|--host HOST|--check]\n"; exit 0; }
    else { die "unknown argument: $a\n"; }
}
for ($hosts_file,$roles_file,$checks_file,$services_file) { defined($_) && -f $_ && !-l $_ or die "invalid service model input\n"; }
($list || $check || $want_host) or die "select --list, --host or --check\n";
my (%roles,%hosts,%checks,%services);
my $role_records = read_roles($roles_file);
my ($host_records) = read_host_records($hosts_file, $role_records, 0);
my $check_records = read_checks($checks_file);
my $service_records = read_services($services_file, $role_records, $check_records);
%roles = map { $_ => 1 } keys %$role_records;
%checks = map { $_ => $check_records->{$_}->{role} } keys %$check_records;
%hosts = map { $_ => [ $host_records->{$_}->{host}, $host_records->{$_}->{role}, $host_records->{$_}->{profile} ] } keys %$host_records;
%services = map { $_ => [ $service_records->{$_}->{service}, $service_records->{$_}->{role}, $service_records->{$_}->{check}, $service_records->{$_}->{profile}, $service_records->{$_}->{description} ] } keys %$service_records;
sub applies { my ($service,$role) = @_; return $service->[1] eq '*' || $service->[1] eq 'baseline' || $service->[1] eq $role; }
if ($want_host) { valid_host($want_host) && exists($hosts{$want_host}) or die "unknown host: $want_host\n"; my $h = $hosts{$want_host}; for my $s (sort keys %services) { my $v=$services{$s}; print join("\t",$want_host,@$v),"\n" if applies($v,$h->[1]); } }
elsif ($list) { for my $s (sort keys %services) { print join("\t",@{$services{$s}}),"\n"; } }
print "services=",scalar(keys %services)," hosts=",scalar(keys %hosts)," status=OK\n" if $check;
exit 0;
