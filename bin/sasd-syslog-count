#!/usr/bin/env perl
# Aggregate traditional BSD syslog by program name, never print message text.
# A classic BSD syslog line has no reliable severity field; none is inferred.
use strict;
my $file='-';
while (@ARGV) {
    my $a=shift @ARGV;
    if ($a eq '--input') { $file=shift @ARGV; }
    elsif ($a eq '--help') { print "usage: sasd-syslog-count [--input LOGFILE|-]\n"; exit 0; }
    else { die "unknown argument: $a\n"; }
}
if ($file ne '-') {
    -f $file && !-l $file or die "invalid logfile\n";
    open(IN,"<$file") or die "cannot open log: $!\n";
} else { *IN=*STDIN; }
my (%counts,$total)=((),0);
while (<IN>) {
    $total++;
    if (/^[A-Z][a-z]{2}\s+\d{1,2}\s+\d{2}:\d{2}:\d{2}\s+\S+\s+([A-Za-z0-9_.\/-]+)(?:\[\d+\])?:/) {
        $counts{$1}++;
    } else { $counts{'_unparsed'}++; }
}
for my $name (sort keys %counts) {
    print "$name\t$counts{$name}\n";
}
print "TOTAL\t$total\n";
